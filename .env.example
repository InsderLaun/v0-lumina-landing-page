# SPRINT_Z2: addresses cleared pre-redeploy. Populate after new deployment.
# ─────────────────────────────────────────────────────────────────
# v0-lumina-landing-page — environment configuration
# Copy to .env.local for development. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────

# WalletConnect — REQUIRED in production. Sign up at:
#   https://cloud.walletconnect.com
# In dev the app will warn if missing; in prod it will THROW at boot.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: paid Base Sepolia RPC (Alchemy/Infura/QuickNode). When
# unset, both the wagmi transport and the /api/rpc proxy fall back to
# the public Base Sepolia endpoints (which are rate-limited).
NEXT_PUBLIC_RPC_URL=

# [Sprint F] Multi-provider RPC redundancy for wagmi. When set, the wagmi
# transport wraps these in a `fallback([alchemy, quicknode, public])` so a
# single provider outage doesn't blank the dApp. NEXT_PUBLIC_RPC_URL_ALCHEMY
# is preferred over NEXT_PUBLIC_RPC_URL when both are set.
# https://sepolia.base.org is appended automatically as last-resort.
NEXT_PUBLIC_RPC_URL_ALCHEMY=
NEXT_PUBLIC_RPC_URL_QUICKNODE=
